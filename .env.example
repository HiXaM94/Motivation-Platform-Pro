# Environment Configuration for Motivation Platform Pro
# Copy this file to .env and fill in your actual API keys
# DO NOT commit the .env file with real keys to version control

# OpenAI API Key for chatbot functionality
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API v3 Key for inspiration feed
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Inspiration Provider - which service to use for inspiration feed
# Options: youtube, mock
# Use 'mock' for development without API keys
INSPIRATION_PROVIDER=mock

# Backup interval in minutes for auto-backup functionality
# Set to 0 to disable auto-backup
BACKUP_INTERVAL=30

# Server Configuration (optional)
# PORT=3000
# NODE_ENV=development
