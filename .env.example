# Environment Variables Configuration
# 
# IMPORTANT: DO NOT commit this file with real values!
# Copy this file to .env and add your actual API keys.
# The .env file is gitignored and should never be committed.

# ============================================
# API Keys (Required for production features)
# ============================================

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# Used for: Chatbot functionality
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API v3 Key
# Get your key from: https://console.cloud.google.com/apis/credentials
# Used for: Inspiration feed with YouTube content
YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# Configuration Options
# ============================================

# OpenAI Model Selection
# Options: gpt-4o-mini (default), gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Note: gpt-4o-mini is recommended for cost-effectiveness
OPENAI_MODEL=gpt-4o-mini

# Inspiration Content Provider
# Options: mock (default), youtube, rss
# Set to 'mock' for development without API keys
INSPIRATION_PROVIDER=mock

# Export Backup Interval (in minutes)
# How often to automatically backup user data
# Set to 0 to disable automatic backups
EXPORT_BACKUP_INTERVAL_MINUTES=60

# ============================================
# Server Configuration (Optional)
# ============================================

# Server Port
# Default: 3000
PORT=3000

# Node Environment
# Options: development, production, test
NODE_ENV=development

# ============================================
# GitHub Actions / CI/CD
# ============================================
# For production deployment, add these secrets to:
# GitHub Repository Settings > Secrets and variables > Actions
# 
# Required secrets:
# - OPENAI_API_KEY
# - YOUTUBE_API_KEY
